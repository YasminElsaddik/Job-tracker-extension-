{
  "manifest_version": 3,
  "name": "Job Tracker",
  "version": "1.1",
  "description": "Log job applications to Notion in one click",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.ashbyhq.com/*",
    "https://*.greenhouse.io/*",
    "https://api.notion.com/*",
    "https://api.anthropic.com/*",
    "https://*.workatastartup.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.greenhouse.io/*", 
        "https://*.workatastartup.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}